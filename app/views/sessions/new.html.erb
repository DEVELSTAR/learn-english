<div class="mx-auto max-w-md w-full py-12 px-4 sm:px-6">
  <div class="bg-white border border-stone-200 rounded-xl p-8 shadow-xs">
    <div class="mb-6">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-900">Sign in</h1>
      <p class="text-sm text-stone-500 mt-1">Continue your daily vocabulary journey.</p>
    </div>

    <%= form_with url: session_url, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email_address, "Email Address", class: "block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-1" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com", value: params[:email_address], class: "w-full rounded-md border border-stone-300 px-3 py-2 text-stone-900 placeholder-stone-400 focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 text-sm" %>
      </div>

      <div data-controller="password-visibility">
        <div class="flex items-center justify-between mb-1">
          <%= f.label :password, "Password", class: "block text-xs font-semibold uppercase tracking-wider text-stone-600" %>
          <%= link_to "Forgot password?", new_password_path, class: "text-xs text-stone-500 hover:text-stone-900 underline" %>
        </div>
        <div class="relative">
          <%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, data: { password_visibility_target: "input" }, class: "w-full rounded-md border border-stone-300 px-3 py-2 pr-16 text-stone-900 placeholder-stone-400 focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 text-sm" %>
          <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 flex items-center px-3 text-xs font-semibold text-stone-500 hover:text-stone-800 cursor-pointer focus:outline-none select-none">
            <span data-password-visibility-target="showText">Show</span>
            <span data-password-visibility-target="hideText" class="hidden">Hide</span>
          </button>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "Sign in", class: "w-full rounded-md bg-stone-900 py-2.5 px-4 text-sm font-medium text-white hover:bg-stone-800 transition cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 border-t border-stone-100 pt-4 text-center text-sm text-stone-500">
      Don't have an account yet?
      <%= link_to "Create an account", new_registration_path, class: "font-medium text-stone-900 underline hover:no-underline ml-1" %>
    </div>
  </div>
</div>
