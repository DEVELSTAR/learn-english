<% is_reply = comment.reply? %>
<% root_id = is_reply ? comment.parent_id : comment.id %>

<div id="lesson_comment_<%= comment.id %>" class="<%= is_reply ? 'pt-3 first:pt-0' : 'pt-5 first:pt-0' %> group">
  <div class="flex items-start gap-3">
    <div class="pt-0.5 shrink-0">
      <%= user_avatar_badge(comment.user, size: is_reply ? :sm : :md) %>
    </div>

    <div class="flex-1 min-w-0">
      <!-- Comment Meta: Name, Role, Timestamp -->
      <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 mb-1.5">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-xs font-bold text-stone-900">
            <%= comment.user&.name || "Student" %>
          </span>
          <%= user_role_tag(comment.user) %>
        </div>

        <time datetime="<%= comment.created_at.iso8601 %>" class="text-[11px] text-stone-400 font-mono">
          <%= time_ago_in_words(comment.created_at) %> ago
        </time>
      </div>

      <!-- Comment Content Bubble -->
      <div class="text-sm text-stone-800 leading-relaxed whitespace-pre-wrap break-words bg-stone-50/90 p-3.5 rounded-2xl border border-stone-200/80 shadow-2xs">
        <%= comment.content %>
      </div>

      <!-- Action Buttons -->
      <div class="mt-2 flex items-center gap-3 text-xs">
        <% if authenticated? %>
          <button type="button"
                  onclick="const box = document.getElementById('reply_box_<%= root_id %>'); if (box) { box.classList.remove('hidden'); box.querySelector('textarea')?.focus(); }"
                  class="inline-flex items-center gap-1 font-medium text-stone-500 hover:text-stone-900 transition cursor-pointer">
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M7.707 3.293a1 1 0 010 1.414L5.414 7H11a7 7 0 017 7v2a1 1 0 11-2 0v-2a5 5 0 00-5-5H5.414l2.293 2.293a1 1 0 11-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Reply</span>
          </button>
        <% end %>

        <% if authenticated? && (comment.user == current_user || current_user.admin?) %>
          <%= button_to lesson_comment_path_for(comment.lesson, comment),
                        method: :delete,
                        data: { turbo_confirm: "Are you sure you want to delete this comment?" },
                        class: "inline-flex items-center gap-1 font-medium text-stone-400 hover:text-rose-600 transition cursor-pointer" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span>Delete</span>
          <% end %>
        <% end %>
      </div>

      <% unless is_reply %>
        <!-- Nested replies container -->
        <div id="lesson_comment_<%= comment.id %>_replies" class="mt-3 pl-4 sm:pl-5 border-l-2 border-stone-200 space-y-3">
          <% comment.replies.each do |reply| %>
            <%= render partial: "lesson_comments/comment", locals: { comment: reply } %>
          <% end %>
        </div>

        <!-- Inline reply box for this thread -->
        <% if authenticated? %>
          <div id="reply_box_<%= comment.id %>" class="hidden pl-4 sm:pl-5 border-l-2 border-stone-200 mt-2">
            <%= render partial: "lesson_comments/form", locals: { lesson: comment.lesson, parent_id: comment.id } %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
