<section id="comments-section" class="bg-white border border-stone-200 rounded-xl shadow-xs overflow-hidden scroll-mt-6" data-controller="chat-room" data-chat-room-url-value="<%= lesson_comment_path_for(@lesson) %>" data-chat-room-interval-value="3000">
  <!-- 1. Chat Room Header -->
  <div class="px-5 py-3 border-b border-stone-200 bg-stone-50/70 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <h2 class="text-sm font-bold text-stone-900 tracking-tight">
        <%= @lesson.topic? ? "Topic Discussion" : "Class Discussion" %>
      </h2>
      <span id="lesson_comments_count" class="text-xs font-mono font-semibold text-stone-500 bg-stone-200/80 px-2 py-0.5 rounded-full">
        <%= @lesson.lesson_comments.count %>
      </span>
    </div>
  </div>

  <!-- 2. Scrollable Messages Container (Chronological order) -->
  <div id="chat_room_messages"
       data-chat-room-target="messages"
       class="h-[360px] sm:h-[400px] overflow-y-auto p-4 sm:p-5 bg-stone-50/30 scroll-smooth">
    <div id="lesson_comments_list" class="space-y-3">
      <% if @comments.present? && @comments.any? %>
        <% @comments.each do |comment| %>
          <%= render partial: "lesson_comments/chat_bubble", locals: { comment: comment } %>
        <% end %>
      <% else %>
        <%= render partial: "lesson_comments/chat_empty_state" %>
      <% end %>
    </div>
  </div>

  <!-- 3. Docked Chat Input Bar at the Bottom -->
  <div class="border-t border-stone-200 bg-white p-3">
    <% if authenticated? %>
      <%= form_with model: LessonComment.new,
                    url: lesson_comment_path_for(@lesson),
                    id: "chat_room_form",
                    class: "m-0",
                    data: {
                      turbo: true,
                      chat_room_target: "form",
                      action: "turbo:submit-end->chat-room#reset"
                    } do |f| %>
        <div class="flex items-center gap-2">
          <%= f.text_field :content,
                           id: "chat_message_input",
                           placeholder: "Type a message...",
                           required: true,
                           autocomplete: "off",
                           class: "flex-1 rounded-lg border border-stone-300 bg-stone-50/50 px-3.5 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:bg-white focus:border-stone-900 focus:ring-1 focus:ring-stone-900 transition" %>

          <%= f.button type: :submit,
                       class: "px-4 py-2 bg-stone-900 hover:bg-stone-800 text-white text-xs font-semibold rounded-lg flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-xs shrink-0" do %>
            <span>Send</span>
            <svg style="width: 14px; height: 14px;" class="shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="flex items-center justify-between gap-3 p-2.5 bg-stone-50 rounded-lg border border-stone-200 text-xs text-stone-600">
        <span>Sign in to participate in the class discussion.</span>
        <%= link_to "Sign In", new_session_path, class: "px-3 py-1 bg-stone-900 text-white text-xs font-semibold rounded-md hover:bg-stone-800 transition shrink-0" %>
      </div>
    <% end %>
  </div>
</section>
