<section id="comments-section" class="bg-white border border-stone-200 rounded-xl p-6 sm:p-8 shadow-xs scroll-mt-6">
  <!-- Section Header -->
  <div class="flex items-center justify-between pb-4 border-b border-stone-200">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-stone-900 tracking-tight">
            <%= @lesson.topic? ? "Topic Discussion" : "Class Discussion" %>
          </h2>
          <span id="lesson_comments_count" class="text-xs font-bold px-2 py-0.5 rounded-full bg-stone-100 text-stone-700 font-mono">
            <%= @lesson.lesson_comments.count %>
          </span>
        </div>
        <p class="text-xs text-stone-500 mt-0.5">
          Ask questions, discuss with classmates and teachers, or practice sentences.
        </p>
      </div>
    </div>
  </div>

  <!-- New Comment Form / Authentication Prompt -->
  <div class="py-5 border-b border-stone-150">
    <% if authenticated? %>
      <%= render partial: "lesson_comments/form", locals: { lesson: @lesson, parent_id: nil } %>
    <% else %>
      <div class="p-4 rounded-xl bg-stone-50 border border-stone-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="text-xs text-stone-600">
          <p class="font-semibold text-stone-900">Join the discussion</p>
          <p class="text-stone-500 mt-0.5">Sign in to ask questions, chat with other students, or receive teacher guidance.</p>
        </div>
        <%= link_to "Sign In to Comment", new_session_path, class: "px-3.5 py-1.5 text-xs font-semibold text-white bg-stone-900 hover:bg-stone-800 rounded-lg shadow-xs transition shrink-0" %>
      </div>
    <% end %>
  </div>

  <!-- Comments List Container -->
  <div id="lesson_comments_list" class="space-y-5 pt-5 divide-y divide-stone-100">
    <% if @comments.present? && @comments.any? %>
      <%= render partial: "lesson_comments/comment", collection: @comments, as: :comment %>
    <% else %>
      <%= render partial: "lesson_comments/empty_state" %>
    <% end %>
  </div>
</section>

