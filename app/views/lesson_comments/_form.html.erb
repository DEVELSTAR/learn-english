<% parent_id ||= nil %>
<% comment ||= LessonComment.new(parent_id: parent_id) %>
<% placeholder ||= (parent_id ? "Write a helpful reply..." : "Ask a question, share an example sentence, or discuss this class...") %>
<% form_dom_id = parent_id ? "reply_form_lesson_comment_#{parent_id}_inner" : "new_lesson_comment_form" %>

<div id="<%= parent_id ? "reply_form_lesson_comment_#{parent_id}" : "new_lesson_comment_form_wrapper" %>" class="<%= parent_id ? 'mt-3 pt-3 border-t border-stone-100' : '' %>">
  <%= form_with model: comment, url: lesson_comment_path_for(lesson), id: form_dom_id, class: "space-y-3", data: { turbo: true } do |f| %>
    <% if parent_id %>
      <%= f.hidden_field :parent_id, value: parent_id %>
    <% end %>

    <% if comment.errors.any? %>
      <div class="rounded-xl bg-rose-50 border border-rose-200 p-3 text-xs text-rose-700">
        <%= comment.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="flex items-start gap-3">
      <div class="pt-0.5 shrink-0">
        <%= user_avatar_badge(current_user, size: parent_id ? :sm : :md) %>
      </div>

      <div class="flex-1 min-w-0">
        <div class="rounded-2xl border border-stone-200 bg-stone-50/50 p-2.5 focus-within:border-stone-900 focus-within:bg-white focus-within:ring-1 focus-within:ring-stone-900 transition shadow-2xs">
          <%= f.text_area :content,
                          rows: parent_id ? 2 : 3,
                          placeholder: placeholder,
                          required: true,
                          class: "w-full border-0 bg-transparent p-1.5 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:ring-0 resize-y leading-relaxed" %>

          <div class="mt-2 pt-2 border-t border-stone-200/60 flex flex-wrap items-center justify-between gap-2 px-1">
            <span class="text-[11px] text-stone-400">
              <%= parent_id ? "Replying to discussion thread" : "Tip: Ask doubts in Hinglish or write practice sentences" %>
            </span>

            <div class="flex items-center gap-2">
              <% if parent_id %>
                <button type="button"
                        onclick="document.getElementById('reply_box_<%= parent_id %>').classList.add('hidden')"
                        class="px-3 py-1.5 text-xs font-medium text-stone-600 hover:text-stone-900 hover:bg-stone-100 rounded-lg transition cursor-pointer">
                  Cancel
                </button>
              <% end %>
              <%= f.button type: :submit,
                           class: "inline-flex items-center gap-1.5 px-4 py-1.5 text-xs font-semibold text-white bg-stone-900 hover:bg-stone-800 rounded-lg shadow-xs transition active:scale-95 cursor-pointer shrink-0" do %>
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
                </svg>
                <span><%= parent_id ? "Reply" : "Post Comment" %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
