<%= turbo_stream.remove "no_comments_placeholder" %>
<%= turbo_stream.append "lesson_comments_list", partial: "lesson_comments/chat_bubble", locals: { comment: @comment } %>
<%= turbo_stream.update "lesson_comments_count", @lesson.lesson_comments.count.to_s %>

<script>
  (() => {
    const el = document.getElementById('chat_room_messages');
    if (el) {
      requestAnimationFrame(() => { el.scrollTop = el.scrollHeight; });
    }
  })();
</script>
