<% is_own = authenticated? && (comment.user_id == current_user.id) %>
<% is_teacher = comment.user&.admin? %>

<% if is_own %>
  <!-- Outgoing Message (Current User) -->
  <div id="lesson_comment_<%= comment.id %>" class="flex items-end justify-end gap-1.5 group">
    <!-- Delete button (visible on hover) -->
    <div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center mb-1">
      <%= button_to lesson_comment_path_for(comment.lesson, comment),
                    method: :delete,
                    data: { turbo_confirm: "Delete this message?" },
                    class: "p-1 text-stone-400 hover:text-rose-600 transition cursor-pointer",
                    title: "Delete message" do %>
        <svg style="width: 14px; height: 14px;" class="shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    </div>

    <!-- Bubble -->
    <div class="max-w-[80%] sm:max-w-[70%] rounded-2xl rounded-br-xs bg-stone-900 text-white px-3.5 py-2 shadow-2xs">
      <div class="text-xs sm:text-sm leading-relaxed whitespace-pre-wrap break-words"><%= comment.content&.strip %></div>
      <div class="mt-1 text-[10px] text-stone-400 text-right font-mono">
        <%= comment.created_at.strftime("%I:%M %p") %>
      </div>
    </div>
  </div>
<% else %>
  <!-- Incoming Message (Other Student or Teacher) -->
  <div id="lesson_comment_<%= comment.id %>" class="flex items-start gap-2 group">
    <div class="max-w-[80%] sm:max-w-[70%]">
      <!-- Sender Name & Role Tag -->
      <div class="flex items-center gap-1.5 mb-1 px-1">
        <span class="text-xs font-semibold text-stone-800"><%= comment.user&.name || "Student" %></span>
        <% if is_teacher %>
          <span class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.2 rounded font-semibold">Teacher</span>
        <% end %>
      </div>

      <!-- Bubble -->
      <div class="rounded-2xl rounded-bl-xs <%= is_teacher ? 'bg-amber-50 border border-amber-200 text-stone-900' : 'bg-white border border-stone-200 text-stone-900' %> px-3.5 py-2 shadow-2xs">
        <div class="text-xs sm:text-sm leading-relaxed whitespace-pre-wrap break-words"><%= comment.content&.strip %></div>
        <div class="mt-1 text-[10px] text-stone-400 text-right font-mono">
          <%= comment.created_at.strftime("%I:%M %p") %>
        </div>
      </div>
    </div>

    <!-- Admin moderation delete button -->
    <% if authenticated? && current_user.super_admin? %>
      <div class="opacity-0 group-hover:opacity-100 transition-opacity self-center">
        <%= button_to lesson_comment_path_for(comment.lesson, comment),
                      method: :delete,
                      data: { turbo_confirm: "Delete this message?" },
                      class: "p-1 text-stone-400 hover:text-rose-600 transition cursor-pointer",
                      title: "Delete message" do %>
          <svg style="width: 14px; height: 14px;" class="shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
