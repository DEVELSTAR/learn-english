<% content_for :title, "Notes" %>

<div class="max-w-3xl mx-auto space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between border-b border-stone-200 pb-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-stone-900">
        Notes
      </h1>
      <p class="text-xs text-stone-500 mt-0.5">
        Share sentences, phrases, and study notes with classmates.
      </p>
    </div>
    <span class="text-xs text-stone-500 font-mono">
      <%= pluralize(@notes.count, "note") %>
    </span>
  </div>

  <!-- Pending Invitations Banner (if any) -->
  <% if authenticated? && @pending_shares.any? %>
    <div id="pending_invitations_wrapper" class="bg-blue-50/70 border border-blue-200 rounded-xl p-4 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-blue-950 flex items-center gap-1.5">
          <span>📬 Note Invitations (<%= @pending_shares.count %>)</span>
        </span>
        <span id="pending_invitations_count" class="text-[11px] font-mono font-semibold text-blue-700 bg-blue-100 px-2 py-0.5 rounded-full">
          <%= @pending_shares.count %>
        </span>
      </div>

      <div class="space-y-2">
        <% @pending_shares.each do |share| %>
          <div id="note_invitation_<%= share.id %>" class="p-3 bg-white rounded-lg border border-blue-200/80 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 text-xs">
                <span class="font-bold text-stone-900"><%= share.note.user.name %></span>
                <span class="text-stone-500">invited you to a note</span>
                <span class="text-[10px] bg-stone-100 text-stone-600 px-1.5 py-0.2 rounded font-medium">
                  <%= share.can_edit? ? "Can edit" : "View only" %>
                </span>
                <% if share.note.lesson %>
                  <span class="text-[10px] bg-emerald-50 text-emerald-800 px-1.5 py-0.2 rounded font-medium">
                    <%= share.note.lesson.topic? ? "Topic" : "Class" %>
                  </span>
                <% end %>
              </div>
              <p class="text-xs text-stone-600 truncate mt-1 font-sans">
                "<%= share.note.content.truncate(85) %>"
              </p>
            </div>

            <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
              <%= button_to "Accept", accept_note_share_path(share), method: :post, class: "px-3 py-1 bg-stone-900 text-white text-xs font-semibold rounded-lg hover:bg-stone-800 transition cursor-pointer shadow-xs" %>
              <%= button_to "Decline", decline_note_share_path(share), method: :post, class: "px-2.5 py-1 text-xs text-stone-500 hover:text-rose-600 transition cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Share Note Form (if authenticated) or Sign In prompt -->
  <% if authenticated? %>
    <%= render partial: "notes/form", locals: { note: @new_note } %>
  <% else %>
    <div class="p-4 rounded-xl bg-stone-100 border border-stone-200 flex items-center justify-between gap-4">
      <p class="text-xs text-stone-600">Sign in to add or edit notes.</p>
      <%= link_to "Sign In", new_session_path, class: "px-3.5 py-1.5 text-xs font-semibold text-white bg-stone-900 hover:bg-stone-800 rounded-lg shadow-xs transition shrink-0" %>
    </div>
  <% end %>

  <!-- Filter Tabs -->
  <div class="flex items-center gap-1.5 text-xs flex-wrap border-b border-stone-100 pb-2">
    <%= link_to "All Notes", notes_path(filter: "all"), class: "px-3 py-1 rounded-md font-medium #{(@filter == 'all' || @filter.blank?) ? 'bg-stone-900 text-white font-semibold' : 'text-stone-600 hover:bg-stone-100'} transition" %>
    <%= link_to "General", notes_path(filter: "general"), class: "px-3 py-1 rounded-md font-medium #{@filter == 'general' ? 'bg-stone-900 text-white font-semibold' : 'text-stone-600 hover:bg-stone-100'} transition" %>
    <%= link_to "Class & Topic Notes", notes_path(filter: "lesson"), class: "px-3 py-1 rounded-md font-medium #{@filter == 'lesson' ? 'bg-stone-900 text-white font-semibold' : 'text-stone-600 hover:bg-stone-100'} transition" %>
    <% if authenticated? %>
      <%= link_to "Shared with Me", notes_path(filter: "shared"), class: "px-3 py-1 rounded-md font-medium #{@filter == 'shared' ? 'bg-stone-900 text-white font-semibold' : 'text-stone-600 hover:bg-stone-100'} transition" %>
      <%= link_to "My Notes", notes_path(filter: "mine"), class: "px-3 py-1 rounded-md font-medium #{@filter == 'mine' ? 'bg-stone-900 text-white font-semibold' : 'text-stone-600 hover:bg-stone-100'} transition" %>
    <% end %>
  </div>

  <!-- Notes List -->
  <div id="notes_list" class="space-y-4">
    <% if @notes.any? %>
      <%= render partial: "notes/note", collection: @notes, as: :note %>
    <% else %>
      <div id="no_notes_placeholder" class="py-12 text-center text-xs text-stone-500 bg-white border border-stone-200 rounded-xl p-6">
        No notes found. Be the first to share one!
      </div>
    <% end %>
  </div>
</div>
