<div id="note_<%= note.id %>" class="bg-amber-50/40 border border-amber-300 rounded-xl p-5 shadow-xs transition">
  <div class="mb-3">
    <span class="text-xs font-bold text-amber-900">Editing Note</span>
  </div>

  <%= form_with model: note, url: note_path(note), method: :patch, class: "space-y-3", data: { turbo: true } do |f| %>
    <% if note.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 p-2.5 text-xs text-rose-700">
        <%= note.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.text_area :content,
                      rows: 6,
                      required: true,
                      placeholder: "Write your sentences or notes here...",
                      class: "w-full min-h-[140px] rounded-lg border border-stone-300 bg-white p-3.5 text-sm text-stone-900 focus:border-stone-900 focus:ring-1 focus:ring-stone-900 resize-y leading-relaxed font-sans" %>
    </div>

    <div class="flex items-center justify-end gap-2 pt-1">
      <%= link_to "Cancel", notes_path, class: "px-3.5 py-2 text-xs font-medium text-stone-600 hover:text-stone-900 transition cursor-pointer" %>
      <%= f.submit "Save Changes", class: "px-5 py-2 bg-stone-900 text-white rounded-lg text-xs font-semibold hover:bg-stone-800 transition cursor-pointer shadow-xs" %>
    </div>
  <% end %>
</div>
