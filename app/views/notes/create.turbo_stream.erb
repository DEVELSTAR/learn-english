<%= turbo_stream.remove "no_notes_placeholder" %>
<%= turbo_stream.remove "no_lesson_notes_placeholder" %>

<% if @note.lesson_id.present? %>
  <%= turbo_stream.prepend "lesson_notes_list", partial: "notes/note", locals: { note: @note } %>
  <%= turbo_stream.replace "new_lesson_note_form_wrapper", partial: "notes/form", locals: { note: Note.new(lesson_id: @note.lesson_id), lesson: @note.lesson } %>
<% end %>

<%= turbo_stream.prepend "notes_list", partial: "notes/note", locals: { note: @note } %>
<%= turbo_stream.replace "new_note_form_wrapper", partial: "notes/form", locals: { note: Note.new } %>
<%= turbo_stream.update "flash_messages", partial: "shared/flash" %>
