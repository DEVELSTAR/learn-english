<% lesson ||= local_assigns[:lesson] || note.lesson %>
<% form_wrapper_id = lesson ? "new_lesson_note_form_wrapper" : "new_note_form_wrapper" %>
<% form_id = lesson ? "new_lesson_note_form" : "new_note_form" %>
<% students = @available_students || (authenticated? ? User.students.where.not(id: current_user.id).order(:name) : []) %>

<div id="<%= form_wrapper_id %>" class="bg-white border border-stone-200 rounded-xl p-5 shadow-xs">
  <%= form_with model: note, url: notes_path, id: form_id, class: "space-y-3", data: { turbo: true } do |f| %>
    <% if note.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 p-2.5 text-xs text-rose-700">
        <%= note.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <% if lesson %>
      <%= f.hidden_field :lesson_id, value: lesson.id %>
    <% end %>

    <div>
      <%= f.text_area :content,
                      rows: lesson ? 4 : 6,
                      required: true,
                      placeholder: lesson ? "Write a note for this #{lesson.topic? ? 'topic' : 'class'}..." : "Write your sentences or notes here...",
                      class: "w-full min-h-[120px] rounded-lg border border-stone-300 bg-white p-3.5 text-sm text-stone-900 placeholder:text-stone-400 focus:border-stone-900 focus:ring-1 focus:ring-stone-900 transition resize-y leading-relaxed font-sans" %>
    </div>

    <!-- Optional Sharing Settings -->
    <% if authenticated? && students.any? %>
      <details class="group text-xs text-stone-600">
        <summary class="cursor-pointer font-medium hover:text-stone-900 select-none flex items-center gap-1.5 py-1 text-stone-500">
          <svg style="width: 14px; height: 14px;" class="transition-transform group-open:rotate-90 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span>Share: <strong class="text-stone-700">Public to all</strong> (click to share with specific students)</span>
        </summary>

        <div class="mt-2 p-3 rounded-lg bg-stone-50 border border-stone-200 space-y-2.5">
          <div class="flex items-center gap-4">
            <label class="flex items-center gap-1.5 cursor-pointer">
              <%= radio_button_tag :sharing_mode, "global", true, class: "text-stone-900 focus:ring-stone-900", onchange: "document.getElementById('specific_students_box_#{form_id}').classList.add('hidden')" %>
              <span class="font-medium text-stone-800">Public (Anyone can see)</span>
            </label>

            <label class="flex items-center gap-1.5 cursor-pointer">
              <%= radio_button_tag :sharing_mode, "shared", false, class: "text-stone-900 focus:ring-stone-900", onchange: "document.getElementById('specific_students_box_#{form_id}').classList.remove('hidden')" %>
              <span class="font-medium text-stone-800">Share with students</span>
            </label>
          </div>

          <div id="specific_students_box_<%= form_id %>" class="hidden space-y-2 pt-2 border-t border-stone-200">
            <label class="block font-semibold text-stone-700">Select students:</label>
            <div class="max-h-32 overflow-y-auto border border-stone-200 bg-white rounded-md p-2 space-y-1">
              <% students.each do |student| %>
                <label class="flex items-center gap-2 cursor-pointer hover:bg-stone-50 p-1 rounded">
                  <%= check_box_tag "invite_user_ids[]", student.id, false, id: "invite_user_#{form_id}_#{student.id}", class: "rounded border-stone-300 text-stone-900 focus:ring-stone-900" %>
                  <span class="text-xs text-stone-800"><%= student.name %> (<%= student.email_address %>)</span>
                </label>
              <% end %>
            </div>
            <label class="flex items-center gap-1.5 cursor-pointer pt-1">
              <%= check_box_tag :invite_can_edit, "1", false, class: "rounded border-stone-300 text-stone-900 focus:ring-stone-900" %>
              <span class="text-stone-700">Allow invited students to edit this note</span>
            </label>
          </div>
        </div>
      </details>
    <% end %>

    <div class="flex justify-end pt-1">
      <%= f.submit "Post Note",
                   class: "px-5 py-2 text-xs font-semibold text-white bg-stone-900 hover:bg-stone-800 rounded-lg shadow-xs transition active:scale-95 cursor-pointer" %>
    </div>
  <% end %>
</div>
