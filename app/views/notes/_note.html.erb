<div id="note_<%= note.id %>" class="bg-white border border-stone-200 rounded-xl p-5 shadow-xs hover:border-stone-300 transition">
  <!-- Note Header: Context & Timestamp -->
  <div class="flex items-center justify-between gap-3 mb-2.5">
    <div class="flex items-center gap-2 flex-wrap">
      <% if note.lesson %>
        <%= link_to (note.lesson.topic? ? "Topic: #{note.lesson.title.truncate(30)}" : "Class: #{note.lesson.title.truncate(30)}"),
                    (note.lesson.topic? ? topic_path(note.lesson) : lesson_path(note.lesson)),
                    class: "inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md hover:bg-emerald-100 transition" %>
      <% end %>

      <% if note.is_global? %>
        <span class="text-[10px] font-medium text-stone-500 bg-stone-100 px-1.5 py-0.5 rounded">Public</span>
      <% else %>
        <span class="text-[10px] font-medium text-blue-700 bg-blue-50 border border-blue-200 px-1.5 py-0.5 rounded">
          Shared with <%= pluralize(note.note_shares.count, "student") %>
        </span>
      <% end %>
    </div>

    <time datetime="<%= note.created_at.iso8601 %>" class="text-xs text-stone-400 font-mono shrink-0">
      <%= time_ago_in_words(note.updated_at || note.created_at) %> ago
    </time>
  </div>

  <!-- Note Content: Direct clean text -->
  <div class="text-sm text-stone-800 leading-relaxed whitespace-pre-wrap break-words py-1 font-sans"><%= note.content&.strip %></div>

  <!-- Note Footer: Author Info & Actions -->
  <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
    <div class="flex items-center gap-2">
      <span class="font-medium text-stone-700"><%= note.user&.name || "Community" %></span>
      <% if note.user&.admin? %>
        <span class="text-[10px] bg-stone-100 text-stone-600 px-1.5 py-0.5 rounded font-semibold">Teacher</span>
      <% end %>
      <% if authenticated? && note.user != current_user && (share = note.note_shares.find_by(user: current_user, status: :accepted)) %>
        <span class="text-[10px] text-blue-600">
          • <%= share.can_edit? ? "Can edit" : "View only" %>
        </span>
      <% end %>
    </div>

    <div class="flex items-center gap-3">
      <!-- Edit Button: Only if allowed to edit -->
      <% if authenticated? && note.can_edit?(current_user) %>
        <%= link_to "Edit", edit_note_path(note),
                    data: { turbo_stream: true },
                    class: "text-xs font-semibold text-stone-600 hover:text-stone-900 transition cursor-pointer" %>
      <% end %>

      <!-- Delete Button: Only owner or admin can delete -->
      <% if authenticated? && note.can_delete?(current_user) %>
        <%= button_to "Delete", note_path(note),
                      method: :delete,
                      data: { turbo_confirm: "Are you sure you want to delete this note?" },
                      class: "text-xs font-semibold text-stone-400 hover:text-rose-600 transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
