<% content_for :title, "Edit Note" %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <%= link_to "← Back to Notes", notes_path, class: "text-xs font-semibold text-stone-500 hover:text-stone-900 transition" %>
  </div>

  <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-xs">
    <h1 class="text-xl font-bold text-stone-900 mb-4">Edit Note</h1>
    <%= render partial: "notes/edit_form", locals: { note: @note } %>
  </div>
</div>
