<% content_for :title, "Foundational English Topics" %>

<div class="space-y-6">
  <!-- Topics Header & Search -->
  <div class="bg-white border border-stone-200 rounded-xl p-6 sm:p-8 shadow-xs">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800 mb-2">
          <span>📚 Core Frameworks & Guides</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900">Foundational Topics</h1>
        <p class="text-xs sm:text-sm text-stone-500 mt-1 leading-relaxed">
          Structured, essential English guides to build your core grammar and confidence—like <em>"Get started with English"</em> and <em>"Must-know words before you start"</em>.
        </p>
      </div>

      <!-- Search Topics -->
      <div class="w-full md:w-72">
        <%= form_with url: topics_path, method: :get, class: "relative" do %>
          <input type="text" 
                 name="query" 
                 value="<%= params[:query] %>"
                 placeholder="Search topics..." 
                 class="w-full bg-stone-50 rounded-lg border border-stone-200 px-3.5 py-2 pl-9 text-xs sm:text-sm text-stone-900 focus:outline-none focus:border-stone-900 focus:bg-white transition placeholder-stone-400">
          <svg class="w-4 h-4 text-stone-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Topics Grid -->
  <% if @topics.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @topics.each_with_index do |topic, index| %>
        <article class="p-6 rounded-xl border border-stone-200 bg-white hover:border-stone-300 transition shadow-xs flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-3 mb-2.5">
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-stone-100 text-stone-700">
                Topic <%= topic.position.positive? ? topic.position : (index + 1) %>
              </span>
              <% if authenticated? && topic.completed_by?(current_user) %>
                <span class="text-[11px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-semibold flex items-center gap-1">
                  ✓ Completed
                </span>
              <% end %>
            </div>

            <div class="flex items-start justify-between gap-2 mb-2">
              <h2 class="text-lg font-bold text-stone-900 group-hover:text-emerald-700 transition">
                <%= link_to topic.title, topic_path(topic) %>
              </h2>
              <button type="button"
                      data-controller="speaker"
                      data-action="click->speaker#toggle"
                      data-speaker-text-value="<%= strip_tags("#{topic.title}. #{topic.content&.to_plain_text.to_s.truncate(250)}") %>"
                      data-speaker-target="button"
                      title="Listen to topic title & summary"
                      class="shrink-0 p-1.5 text-stone-400 hover:text-emerald-700 hover:bg-emerald-50 rounded-lg transition border border-transparent hover:border-emerald-200 cursor-pointer">
                <span data-speaker-target="icon">🔊</span>
              </button>
            </div>

            <% snippet = topic.content.to_plain_text.strip.truncate(150) if topic.content.present? %>
            <% if snippet.present? %>
              <p class="text-xs sm:text-sm text-stone-600 line-clamp-3 mb-4 leading-relaxed">
                <%= snippet %>
              </p>
            <% end %>
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-stone-100 text-xs mt-2">
            <span class="text-stone-400 text-[11px]">Interactive AI Tutor included</span>
            <%= link_to "Start Topic →", topic_path(topic), class: "font-semibold text-stone-900 group-hover:text-emerald-800 transition flex items-center gap-1" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-xl border border-stone-200 p-8">
      <div class="text-3xl mb-2">📖</div>
      <h3 class="text-base font-bold text-stone-800 mb-1">No topics published yet</h3>
      <p class="text-stone-500 text-xs sm:text-sm max-w-md mx-auto">
        <% if params[:query].present? %>
          No topics matched "<%= params[:query] %>".
          <%= link_to "Clear search", topics_path, class: "inline-block mt-2 text-stone-900 font-semibold hover:text-stone-700 transition block" %>
        <% else %>
          Topics like "Get Started with English" and "Must Know Words" will be published here soon!
        <% end %>
      </p>
      <% if admin? %>
        <div class="mt-4">
          <%= link_to "+ Create Topic in Admin Panel", new_admin_topic_path, class: "inline-flex items-center gap-1.5 px-4 py-2 bg-stone-900 text-white rounded-lg text-xs font-semibold hover:bg-stone-800 transition" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

