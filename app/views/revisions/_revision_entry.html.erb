<div id="<%= dom_id(entry) %>" class="bg-white border border-stone-200 rounded-xl p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all duration-300">
  <div class="space-y-1.5 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-lg font-bold text-stone-900"><%= entry.term %></span>
      <span class="text-xs px-2 py-0.5 rounded bg-stone-100 text-stone-600 font-medium">
        in <%= entry.word_list.name %>
      </span>
      <% if entry.needs_revision? %>
        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-900">
          ★ Flagged
        </span>
      <% end %>
      <span class="text-[10px] font-mono text-stone-400">
        <% if entry.last_reviewed_at.present? %>
          Reviewed <%= time_ago_in_words(entry.last_reviewed_at) %> ago
        <% else %>
          Never reviewed
        <% end %>
      </span>
    </div>

    <% if entry.personal_note.present? %>
      <p class="text-sm text-stone-700 leading-relaxed"><%= entry.personal_note %></p>
    <% end %>

    <% if entry.lesson %>
      <p class="text-xs text-stone-400">
        Class: <%= link_to entry.lesson.title, lesson_path(entry.lesson), class: "underline hover:text-stone-700" %>
      </p>
    <% end %>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-2 shrink-0 pt-3 sm:pt-0 border-t sm:border-t-0 border-stone-100">
    <!-- Mark Reviewed -->
    <%= button_to revision_reviewed_path(entry, filter: filter), method: :post, class: "px-3 py-1.5 rounded-lg text-xs font-semibold border border-stone-300 bg-white hover:bg-stone-50 text-stone-800 transition cursor-pointer" do %>
      ✓ Mark Reviewed
    <% end %>

    <!-- Mastered Button -->
    <%= button_to revision_reviewed_path(entry, filter: filter, mastered: "true"), method: :post, class: "px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 text-white hover:bg-emerald-500 transition shadow-2xs cursor-pointer" do %>
      ★ Mastered!
    <% end %>
  </div>
</div>

