<% if authenticated? %>
  <div class="space-y-8">
    <!-- Top Welcome Banner -->
    <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-stone-900">Namaste, <%= current_user.name.split.first %>!</h1>
        <p class="text-xs text-stone-500 mt-1">Ready to learn and practice English today? Check out daily classes or read community notes.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 bg-stone-100 rounded-full text-xs font-semibold text-stone-700 font-mono">
          <%= @completed_count %> <%= "class".pluralize(@completed_count) %> completed
        </span>
        <%= link_to "View Notes", notes_path, class: "px-3.5 py-1.5 bg-stone-900 text-white rounded-xl text-xs font-semibold hover:bg-stone-800 transition shadow-2xs" %>
      </div>
    </div>

    <!-- Featured / Today's Lesson Banner -->
    <% featured_lesson = @today_lesson || @latest_lesson %>
    <% if featured_lesson.is_a?(Lesson) %>
      <div class="bg-gradient-to-br from-stone-900 to-stone-800 text-white rounded-xl p-6 sm:p-8 shadow-sm">
        <div class="flex items-center justify-between gap-4 mb-3">
          <div class="flex items-center gap-2">
            <% if @today_lesson %>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold tracking-wide uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                Today's Class
              </span>
            <% else %>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold tracking-wide uppercase bg-stone-700 text-stone-300">
                Latest Available Class
              </span>
            <% end %>
            <% if featured_lesson.topic.present? %>
              <span class="text-xs text-stone-400">• <%= featured_lesson.topic %></span>
            <% end %>
          </div>
          <span class="text-xs text-stone-400 font-mono"><%= featured_lesson.lesson_date.strftime("%B %d, %Y") %></span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2"><%= featured_lesson.title %></h2>
        
        <% intro = featured_lesson.content.to_plain_text.strip.truncate(200) if featured_lesson.content.present? %>
        <% if intro.present? %>
          <p class="text-stone-300 text-sm sm:text-base line-clamp-2 max-w-2xl mb-6">
            <%= intro %>
          </p>
        <% end %>

        <% if !@today_lesson %>
          <p class="text-xs text-stone-400 mb-6 italic">
            No new lesson published for today yet. Revise this latest class or explore community notes below!
          </p>
        <% end %>

        <div class="flex flex-wrap items-center gap-3">
          <%= link_to lesson_path(featured_lesson), class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white text-stone-900 font-medium text-sm hover:bg-stone-100 transition shadow-xs" do %>
            <span><%= featured_lesson.completed_by?(current_user) ? "Review Lesson Again" : "Start Learning" %></span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          <% end %>

          <% if featured_lesson.completed_by?(current_user) %>
            <span class="inline-flex items-center gap-1.5 text-xs text-emerald-300 bg-emerald-950/60 border border-emerald-800 px-3 py-1.5 rounded-lg">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Completed
            </span>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="bg-white border border-stone-200 rounded-xl p-8 text-center">
        <h2 class="text-lg font-semibold text-stone-800">Welcome to Learn English!</h2>
        <p class="text-sm text-stone-500 mt-1 max-w-md mx-auto">
          The teacher is currently preparing lessons. In the meantime, feel free to browse foundational topics or contribute to community notes!
        </p>
      </div>
    <% end %>

    <!-- 2-Column Dashboard Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column (2 spans): Recent Classes & Community Notes -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Community Notes & Daily Sentences -->
        <div class="bg-white border border-stone-200 rounded-xl p-6 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-base font-bold text-stone-900">Community Notes & Sentences</h3>
              <p class="text-xs text-stone-500">Daily useful sentences, idioms, and notes shared by everyone.</p>
            </div>
            <%= link_to "View all notes →", notes_path, class: "text-xs font-semibold text-stone-700 hover:text-stone-900 transition" %>
          </div>

          <% if @recent_notes&.any? %>
            <div class="space-y-3">
              <% @recent_notes.each do |note| %>
                <%= link_to notes_path, class: "block p-3.5 rounded-lg border border-stone-200 hover:border-stone-300 hover:bg-stone-50/50 transition group" do %>
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <div class="flex items-center gap-1.5">
                      <span class="text-xs font-semibold text-stone-900 group-hover:text-emerald-700 transition"><%= note.user&.name || "Community" %></span>
                      <% if note.lesson %>
                        <span class="text-[10px] bg-emerald-50 text-emerald-800 px-1.5 py-0.2 rounded font-medium">
                          <%= note.lesson.topic? ? "Topic" : "Class" %>
                        </span>
                      <% end %>
                    </div>
                    <span class="text-[11px] font-mono text-stone-400 shrink-0"><%= time_ago_in_words(note.updated_at) %> ago</span>
                  </div>
                  <p class="text-xs text-stone-700 line-clamp-2 font-sans"><%= note.content.truncate(140) %></p>
                  <div class="mt-2 text-[11px] text-stone-400 flex items-center gap-1.5">
                    <span>By <%= note.user&.name || "Community" %></span>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="p-6 text-center text-xs text-stone-500 bg-stone-50 rounded-lg">
              No community notes added yet.
              <%= link_to "Be the first to share daily sentences →", notes_path, class: "block mt-1 font-semibold text-stone-700 hover:text-stone-900" %>
            </div>
          <% end %>
        </div>

        <!-- Foundational Topics (if any published) -->
        <% if @featured_topics.any? %>
          <div class="bg-white border border-stone-200 rounded-xl p-6 shadow-xs">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-base font-bold text-stone-900">Foundational Topics</h3>
                <p class="text-xs text-stone-500">Core English concepts & frameworks to master.</p>
              </div>
              <%= link_to "View all topics", topics_path, class: "text-xs font-semibold text-stone-700 hover:text-stone-900 transition" %>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% @featured_topics.each do |topic| %>
                <%= link_to topic_path(topic), class: "p-4 rounded-lg border border-stone-100 hover:border-stone-300 hover:bg-stone-50/50 transition group block" do %>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-stone-100 text-stone-600 font-bold">
                    Topic <%= topic.position.positive? ? topic.position : "•" %>
                  </span>
                  <h4 class="font-bold text-sm text-stone-900 group-hover:text-emerald-700 transition mt-1.5 line-clamp-1"><%= topic.title %></h4>
                  <p class="text-xs text-stone-500 line-clamp-2 mt-1">
                    <%= topic.content.to_plain_text.strip.truncate(90) if topic.content.present? %>
                  </p>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Recent Lessons -->
        <div class="bg-white border border-stone-200 rounded-xl p-6 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-base font-bold text-stone-900">Recent Classes</h3>
              <p class="text-xs text-stone-500">Revisit previous classes to reinforce concepts.</p>
            </div>
            <%= link_to "Browse all classes", lessons_path, class: "text-xs font-semibold text-stone-700 hover:text-stone-900 transition" %>
          </div>

          <% if @recent_lessons.any? %>
            <div class="divide-y divide-stone-100">
              <% @recent_lessons.each do |lesson| %>
                <div class="py-3.5 flex items-center justify-between gap-4 first:pt-0 last:pb-0">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-mono text-stone-400"><%= lesson.lesson_date.strftime("%b %d") %></span>
                      <% if lesson.topic.present? %>
                        <span class="text-[11px] px-1.5 py-0.2 bg-stone-100 text-stone-600 rounded"><%= lesson.topic %></span>
                      <% end %>
                      <% if lesson.completed_by?(current_user) %>
                        <span class="text-[10px] text-emerald-700 font-semibold flex items-center gap-0.5">
                          ✓ Done
                        </span>
                      <% end %>
                    </div>
                    <%= link_to lesson.title, lesson_path(lesson), class: "font-semibold text-sm text-stone-900 hover:text-stone-600 truncate block mt-0.5" %>
                  </div>
                  <%= link_to "Open", lesson_path(lesson), class: "text-xs px-3 py-1 rounded border border-stone-200 text-stone-700 hover:bg-stone-50 transition shrink-0" %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-xs text-stone-500 py-4 text-center">No classes published yet.</p>
          <% end %>
        </div>
      </div>

      <!-- Right Column (1 span): Quick Actions & Learning Tips -->
      <div class="space-y-6">
        <!-- Community Notes Shortcut -->
        <div class="bg-white border border-stone-200 rounded-xl p-6 shadow-xs">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-base font-bold text-stone-900">Daily Notes</h3>
            <%= link_to "Open Board", notes_path, class: "text-xs font-semibold text-stone-700 hover:text-stone-900 transition" %>
          </div>
          <p class="text-xs text-stone-600 leading-relaxed mb-4">
            Share daily sentences, phrases, and grammar tips. Everyone can view and collaborate on notes!
          </p>
          <%= link_to "+ Share New Note", notes_path, class: "block w-full py-2.5 px-3 rounded-lg bg-stone-900 text-white font-semibold text-xs text-center hover:bg-stone-800 transition" %>
        </div>

        <!-- Learning Tip Card -->
        <div class="bg-stone-100/70 border border-stone-200 rounded-xl p-5 text-xs text-stone-600 space-y-2">
          <p class="font-semibold text-stone-800 uppercase tracking-wider text-[11px]">Hinglish Tip</p>
          <p class="leading-relaxed">
            Har naye word ko sirf uski dictionary definition se mat samjhein. Use Hinglish mein apne rozmarrah ke context ke saath connect karein — tabhi woh naturally yaad rahega!
          </p>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <!-- Public Landing Page -->
  <div class="py-12 sm:py-16 text-center max-w-3xl mx-auto space-y-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-stone-100 text-stone-800 border border-stone-200">
      <span>🇮🇳 Concept-First Hinglish Learning</span>
    </div>

    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-stone-900 leading-tight">
      Understand English deeply, <br>
      <span class="underline decoration-stone-300">not just memorize words.</span>
    </h1>

    <p class="text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl mx-auto">
      Daily curated lessons conducted in natural Hinglish with real-life stories, pronunciation guides, tone nuances, and your own personal word notebook.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <%= link_to "Create Free Student Account", new_registration_path, class: "w-full sm:w-auto px-6 py-3 rounded-lg bg-stone-900 text-white font-medium text-base hover:bg-stone-800 transition shadow-xs" %>
      <%= link_to "Browse Published Classes", lessons_path, class: "w-full sm:w-auto px-6 py-3 rounded-lg border border-stone-300 text-stone-800 font-medium text-base hover:bg-stone-50 transition" %>
    </div>

    <!-- Recent Published Classes Preview -->
    <% if @recent_lessons.any? %>
      <div class="pt-12 text-left">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-500 mb-4 text-center">Recent Daily Lessons</h2>
        <div class="space-y-3">
          <% @recent_lessons.each do |lesson| %>
            <%= link_to lesson_path(lesson), class: "block p-5 rounded-xl border border-stone-200 bg-white hover:border-stone-400 transition" do %>
              <div class="flex items-center justify-between gap-4">
                <div>
                  <span class="text-xs font-mono text-stone-400 block mb-1"><%= lesson.lesson_date.strftime("%B %d, %Y") %></span>
                  <h3 class="font-bold text-stone-900 text-base"><%= lesson.title %></h3>
                  <% snippet = lesson.content.to_plain_text.strip.truncate(140) if lesson.content.present? %>
                  <% if snippet.present? %>
                    <p class="text-xs text-stone-500 mt-1 line-clamp-1"><%= snippet %></p>
                  <% end %>
                </div>
                <span class="text-xs font-medium text-stone-700 shrink-0">Read →</span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

