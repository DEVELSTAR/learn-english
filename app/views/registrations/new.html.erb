<div class="mx-auto max-w-md w-full py-12 px-4 sm:px-6">
  <div class="bg-white border border-stone-200 rounded-xl p-8 shadow-xs">
    <div class="mb-6">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-900">Create your account</h1>
      <p class="text-sm text-stone-500 mt-1">Start learning English vocabulary deeply, class by class.</p>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-5 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
        <p class="font-medium mb-1">Please fix the following errors:</p>
        <ul class="list-disc list-inside space-y-1">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_path, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, "Your Full Name", class: "block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-1" %>
        <%= f.text_field :name, required: true, autofocus: true, placeholder: "e.g. Rahul Sharma", class: "w-full rounded-md border border-stone-300 px-3 py-2 text-stone-900 placeholder-stone-400 focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 text-sm" %>
      </div>

      <div>
        <%= f.label :email_address, "Email Address", class: "block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-1" %>
        <%= f.email_field :email_address, required: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full rounded-md border border-stone-300 px-3 py-2 text-stone-900 placeholder-stone-400 focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 text-sm" %>
      </div>

      <div data-controller="password-visibility">
        <div class="flex items-center justify-between mb-1">
          <%= f.label :password, "Password", class: "block text-xs font-semibold uppercase tracking-wider text-stone-600" %>
          <button type="button" data-action="click->password-visibility#toggle" class="text-xs font-semibold text-stone-500 hover:text-stone-800 cursor-pointer focus:outline-none select-none">
            <span data-password-visibility-target="showText">Show Password</span>
            <span data-password-visibility-target="hideText" class="hidden">Hide Password</span>
          </button>
        </div>
        <%= f.password_field :password, required: true, autocomplete: "new-password", placeholder: "At least 6 characters", data: { password_visibility_target: "input" }, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-stone-900 placeholder-stone-400 focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 text-sm" %>
      </div>

      <div data-controller="password-visibility">
        <div class="flex items-center justify-between mb-1">
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-semibold uppercase tracking-wider text-stone-600" %>
          <button type="button" data-action="click->password-visibility#toggle" class="text-xs font-semibold text-stone-500 hover:text-stone-800 cursor-pointer focus:outline-none select-none">
            <span data-password-visibility-target="showText">Show Password</span>
            <span data-password-visibility-target="hideText" class="hidden">Hide Password</span>
          </button>
        </div>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat your password", data: { password_visibility_target: "input" }, class: "w-full rounded-md border border-stone-300 px-3 py-2 text-stone-900 placeholder-stone-400 focus:border-stone-900 focus:outline-none focus:ring-1 focus:ring-stone-900 text-sm" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Create Account", class: "w-full rounded-md bg-stone-900 py-2.5 px-4 text-sm font-medium text-white hover:bg-stone-800 transition cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 border-t border-stone-100 pt-4 text-center text-sm text-stone-500">
      Already have an account?
      <%= link_to "Sign in", new_session_path, class: "font-semibold text-stone-900 hover:text-emerald-700 ml-1 transition" %>
    </div>
  </div>
</div>
