<section id="ai-tutor" class="bg-white border border-stone-200 rounded-2xl p-5 sm:p-6 shadow-xs">
  <!-- Tutor Header -->
  <div class="flex items-center justify-between gap-3 border-b border-stone-100 pb-3 mb-4">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-700 to-teal-500 text-white flex items-center justify-center text-sm font-bold shadow-xs shrink-0">
        ✨
      </div>
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-bold text-stone-900 tracking-tight">Ask Akib Sir</h2>
        <span class="text-[10px] font-mono font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-full">
          Gemini 1.5 Flash
        </span>
      </div>
    </div>

    <div class="flex items-center gap-1.5 shrink-0">
      <%= render partial: "lessons/clear_chat_button", locals: { lesson: @lesson, has_messages: @chat_messages.present? } %>
    </div>
  </div>

  <div>
    <!-- Chat History Window -->
    <div id="chat_messages_container" class="max-h-[380px] overflow-y-auto px-1 pr-2 space-y-1 mb-4 scrollbar-thin scrollbar-thumb-stone-200">
      <div id="chat_messages_list">
        <% if authenticated? %>
          <% if @chat_messages.present? %>
            <% @chat_messages.each do |message| %>
              <%= render partial: "lessons/chat_messages/chat_message", locals: { chat_message: message } %>
            <% end %>
          <% else %>
            <%= render partial: "lessons/chat_empty_state" %>
          <% end %>
        <% else %>
          <div class="py-8 text-center text-stone-500 space-y-3 bg-stone-50 rounded-xl border border-dashed border-stone-200 p-6">
            <div class="text-3xl">✨</div>
            <h3 class="text-sm font-bold text-stone-800">Practice with AI Tutor</h3>
            <p class="text-xs text-stone-500 max-w-md mx-auto">
              Sign in to chat with our Google Gemini-powered AI Tutor, ask doubts about <strong><%= @lesson.title %></strong>, and get instant sentence corrections in natural Hinglish!
            </p>
            <div class="pt-1">
              <%= link_to "Sign In to Ask Questions", new_session_path, class: "inline-flex items-center gap-1.5 px-4 py-2 bg-stone-900 text-white rounded-lg text-xs font-semibold hover:bg-stone-800 transition" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Chat Input (if authenticated) -->
    <% if authenticated? %>
      <%= render partial: "lessons/chat_input", locals: { lesson: @lesson } %>
    <% end %>
  </div>
</section>
