<% content_for :title, @lesson.title %>

<div class="max-w-3xl mx-auto space-y-8">
  <% if admin? %>
    <div class="rounded-xl bg-amber-50 border border-amber-200 p-3.5 text-xs text-amber-900 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="font-bold uppercase tracking-wider text-[11px] bg-amber-200/80 px-2 py-0.5 rounded">Admin Preview</span>
        <span>Viewing published content in read-only mode. Comments, chat, and notes are restricted to students.</span>
      </div>
      <%= link_to "← Back to Admin Panel", admin_root_path, class: "font-semibold underline hover:text-amber-950 shrink-0 ml-3" %>
    </div>
  <% end %>

  <!-- Back navigation & Admin controls -->
  <div class="flex items-center justify-between text-xs text-stone-500">
    <% if admin? %>
      <%= link_to "← Back to Admin Panel", admin_root_path, class: "hover:text-stone-900 transition flex items-center gap-1 font-semibold" %>
    <% else %>
      <%= link_to (@lesson.topic? ? "← Back to topics" : "← Back to all classes"), (@lesson.topic? ? topics_path : lessons_path), class: "hover:text-stone-900 transition flex items-center gap-1 font-medium" %>
    <% end %>
    <% if admin? %>
      <div class="flex items-center gap-2">
        <span class="text-[11px] px-2 py-0.5 rounded font-mono font-bold <%= @lesson.published? ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
          <%= @lesson.status.upcase %>
        </span>
        <%= link_to (@lesson.topic? ? "Edit Topic" : "Edit Lesson"), (@lesson.topic? ? edit_admin_topic_path(@lesson) : edit_admin_lesson_path(@lesson)), class: "text-stone-700 hover:text-stone-900 font-semibold transition" %>
      </div>
    <% end %>
  </div>

  <!-- Lesson Header Banner -->
  <div class="border-b border-stone-200 pb-6">
    <div class="flex items-center gap-2 mb-3">
      <% if @lesson.topic? %>
        <span class="text-xs font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded">
          Foundational Topic
        </span>
      <% else %>
        <span class="text-xs font-mono font-semibold text-stone-500 bg-stone-100 px-2.5 py-0.5 rounded">
          <%= @lesson.lesson_date&.strftime("%A, %B %d, %Y") %>
        </span>
      <% end %>
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight leading-tight mb-4">
      <%= @lesson.title %>
    </h1>

    <!-- Student completion controls -->
    <% if authenticated? && !admin? %>
      <%= render partial: "lessons/student_actions", locals: { lesson: @lesson, completion: @completion } %>
    <% end %>
  </div>

  <!-- Render Rich Text Lesson Content (with uploaded images, bullet points, formatting) -->
  <article class="bg-white border border-stone-200 rounded-xl p-6 sm:p-10 shadow-xs">
    <% if @lesson.content.present? %>
      <div class="lesson-rich-text trix-content">
        <%= @lesson.content %>
      </div>
    <% else %>
      <p class="text-stone-400 italic text-sm py-8 text-center">
        No content written for this lesson yet.
      </p>
    <% end %>
  </article>

  <!-- Previous & Next Lesson Navigation Footer -->
  <div class="pt-6 border-t border-stone-200">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <% if @previous_lesson %>
          <%= link_to (@lesson.topic? ? topic_path(@previous_lesson) : lesson_path(@previous_lesson)), class: "block p-4 rounded-xl border border-stone-200 bg-white hover:border-stone-400 transition" do %>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 block mb-1">← <%= @lesson.topic? ? "Previous Topic" : "Previous Class" %></span>
            <span class="text-sm font-bold text-stone-900 line-clamp-1"><%= @previous_lesson.title %></span>
            <span class="text-xs text-stone-500 font-mono"><%= @previous_lesson.lesson_date&.strftime("%b %d, %Y") %></span>
          <% end %>
        <% end %>
      </div>

      <div>
        <% if @next_lesson %>
          <%= link_to (@lesson.topic? ? topic_path(@next_lesson) : lesson_path(@next_lesson)), class: "block p-4 rounded-xl border border-stone-200 bg-white hover:border-stone-400 transition text-right" do %>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 block mb-1"><%= @lesson.topic? ? "Next Topic →" : "Next Class →" %></span>
            <span class="text-sm font-bold text-stone-900 line-clamp-1"><%= @next_lesson.title %></span>
            <span class="text-xs text-stone-500 font-mono"><%= @next_lesson.lesson_date&.strftime("%b %d, %Y") %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Interactive Student Tools Sidebar (AI Tutor, Chatroom, Notes) -->
<% unless admin? %>
  <%= render partial: "lessons/sidebar", locals: { lesson: @lesson } %>
<% end %>
