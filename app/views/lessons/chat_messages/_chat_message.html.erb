<% if chat_message.user? %>
  <!-- Student Message (Right) -->
  <div class="flex items-start justify-end gap-2.5 my-3">
    <div class="max-w-[85%] sm:max-w-[75%] bg-stone-900 text-white px-4 py-2.5 rounded-2xl rounded-tr-xs shadow-2xs text-xs sm:text-sm leading-relaxed">
      <div class="text-[10px] text-stone-400 font-medium mb-1 text-right">You</div>
      <div class="whitespace-pre-wrap"><%= chat_message.content %></div>
    </div>
    <div class="w-7 h-7 rounded-full bg-stone-800 text-stone-200 text-[10px] font-bold flex items-center justify-center shrink-0 shadow-2xs">
      <%= chat_message.user.name.first(2).upcase %>
    </div>
  </div>
<% else %>
  <!-- AI Tutor Message (Left) -->
  <div class="flex items-start justify-start gap-2.5 my-3">
    <div class="w-7 h-7 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center shrink-0 shadow-2xs" title="Gemini 1.5 Flash AI Tutor">
      ✨
    </div>
    <div class="max-w-[90%] sm:max-w-[80%] bg-stone-50 border border-stone-200 text-stone-800 px-4 py-3 rounded-2xl rounded-tl-xs shadow-2xs text-xs sm:text-sm leading-relaxed space-y-2">
      <div class="flex items-center justify-between gap-2 border-b border-stone-200/70 pb-1 text-[11px] font-semibold text-emerald-800">
        <span>Akib Sir (AI Tutor)</span>
        <span class="text-[9px] font-mono font-medium text-stone-400 bg-white px-1.5 py-0.5 rounded border border-stone-200">Gemini 1.5 Flash</span>
      </div>
      <div class="ai-tutor-message-body whitespace-pre-wrap">
        <%= simple_format(chat_message.content, {}, sanitize: false) %>
      </div>
    </div>
  </div>
<% end %>

