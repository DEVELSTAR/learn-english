<!-- Remove empty state if present -->
<%= turbo_stream.remove "chat_empty_state" %>

<!-- Append User Message -->
<%= turbo_stream.append "chat_messages_list" do %>
  <%= render partial: "lessons/chat_messages/chat_message", locals: { chat_message: @user_message } %>
<% end %>

<!-- Append AI Tutor Message -->
<%= turbo_stream.append "chat_messages_list" do %>
  <%= render partial: "lessons/chat_messages/chat_message", locals: { chat_message: @assistant_message } %>
<% end %>

<!-- Reset Chat Input -->
<%= turbo_stream.replace "chat_input_container" do %>
  <%= render partial: "lessons/chat_input", locals: { lesson: @lesson } %>
<% end %>

<!-- Ensure Clear Chat button is available -->
<%= turbo_stream.replace "clear_chat_container" do %>
  <%= render partial: "lessons/clear_chat_button", locals: { lesson: @lesson, has_messages: true } %>
<% end %>

