<% lesson_notes = @lesson.notes.visible_to(current_user).recent %>

<section id="lesson_notes_section" class="bg-white border border-stone-200 rounded-2xl p-5 sm:p-7 shadow-xs space-y-6">
  <!-- Section Header -->
  <div class="flex items-center justify-between border-b border-stone-100 pb-3">
    <div class="flex items-center gap-2">
      <h2 class="text-base font-bold text-stone-900 tracking-tight">
        <%= @lesson.topic? ? "Topic Notes" : "Class Notes" %>
      </h2>
      <span id="lesson_notes_count" class="text-xs font-mono font-semibold text-stone-500 bg-stone-100 px-2 py-0.5 rounded-full">
        <%= lesson_notes.count %>
      </span>
    </div>

    <div>
      <%= link_to "View all notes →", notes_path(lesson_id: @lesson.id), class: "text-xs font-medium text-stone-600 hover:text-stone-900" %>
    </div>
  </div>

  <div class="space-y-6">
    <!-- Note Creation Form for this Lesson -->
    <% if authenticated? %>
      <%= render partial: "notes/form", locals: { note: Note.new(lesson_id: @lesson.id), lesson: @lesson } %>
    <% else %>
      <div class="p-3 bg-stone-50 rounded-xl border border-stone-200 text-xs text-stone-600 flex items-center justify-between gap-3">
        <span>Sign in to write and share notes for this <%= @lesson.topic? ? "topic" : "class" %>.</span>
        <%= link_to "Sign In", new_session_path, class: "px-3 py-1.5 bg-stone-900 text-white text-xs font-semibold rounded-lg hover:bg-stone-800 transition shrink-0" %>
      </div>
    <% end %>

    <!-- Notes List -->
    <div id="lesson_notes_list" class="space-y-4">
      <% if lesson_notes.any? %>
        <%= render partial: "notes/note", collection: lesson_notes, as: :note %>
      <% else %>
        <div id="no_lesson_notes_placeholder" class="py-8 text-center text-xs text-stone-400 bg-stone-50/50 rounded-xl border border-dashed border-stone-200">
          No notes added for this <%= @lesson.topic? ? "topic" : "class" %> yet.
        </div>
      <% end %>
    </div>
  </div>
</section>
