<% comments_count = @comments ? @comments.count : @lesson.lesson_comments.count %>
<% notes_count = @lesson.notes.visible_to(current_user).count %>

<aside data-controller="lesson-sidebar"
       data-lesson-sidebar-is-open-value="false"
       data-lesson-sidebar-active-tab-value="ai_tutor"
       class="relative select-none">

  <!-- ======================================================== -->
  <!-- 0. MOBILE MOVABLE FLOATING MENU (FAB)                     -->
  <!-- Visible only on mobile (< md:), draggable anywhere        -->
  <!-- Clicking directly expands the drawer with the 3 options   -->
  <!-- ======================================================== -->
  <div data-lesson-sidebar-target="mobileFab"
       class="md:hidden fixed bottom-6 right-5 z-40 select-none touch-none">

    <button type="button"
            data-lesson-sidebar-target="mobileFabButton"
            data-action="click->lesson-sidebar#toggle"
            class="w-13 h-13 rounded-full bg-white border border-stone-200/90 shadow-xl flex items-center justify-center text-stone-700 active:scale-90 transition-transform cursor-grab active:cursor-grabbing hover:shadow-2xl ring-4 ring-black/5"
            title="Open English Tools (Drag to move)"
            aria-label="Open English Tools">
      <!-- 4-color diamond logo in center -->
      <div class="grid grid-cols-2 gap-0.5 w-6 h-6 rotate-45 rounded-sm p-0.5 pointer-events-none">
        <div class="bg-blue-500 rounded-tl-xs"></div>
        <div class="bg-red-500 rounded-tr-xs"></div>
        <div class="bg-amber-400 rounded-bl-xs"></div>
        <div class="bg-emerald-500 rounded-br-xs"></div>
      </div>

      <!-- Badge indicator if there are comments or notes -->
      <% if comments_count > 0 || notes_count > 0 %>
        <span class="absolute top-0 right-0 w-3.5 h-3.5 rounded-full bg-blue-600 ring-2 ring-white text-[9px] font-bold text-white flex items-center justify-center pointer-events-none">
          <%= comments_count + notes_count %>
        </span>
      <% end %>
    </button>
  </div>

  <!-- ======================================================== -->
  <!-- 1. DESKTOP/LAPTOP SLIM RAIL (Collapsed state dock on side)-->
  <!-- Visible only on md: screens and above                      -->
  <!-- ======================================================== -->
  <div data-lesson-sidebar-target="rail"
       class="hidden md:flex fixed right-0 top-24 z-30 flex-col items-center bg-white border border-r-0 border-stone-200/90 shadow-md rounded-l-2xl py-3 px-1.5 w-14 transition-all duration-300">

    <!-- Top: 4-color diamond logo & Expand toggle button -->
    <div class="relative w-8 h-8 mb-4 flex items-center justify-center">
      <!-- 4-color logo icon (Clickable to toggle sidebar) -->
      <button type="button"
              data-action="click->lesson-sidebar#toggle"
              class="grid grid-cols-2 gap-0.5 w-6 h-6 rotate-45 rounded-sm p-0.5 hover:scale-110 transition cursor-pointer"
              title="Open English Tools"
              aria-label="Open English Tools">
        <div class="bg-blue-500 rounded-tl-xs"></div>
        <div class="bg-red-500 rounded-tr-xs"></div>
        <div class="bg-amber-400 rounded-bl-xs"></div>
        <div class="bg-emerald-500 rounded-br-xs"></div>
      </button>

      <!-- Circular expand chevron button attached to rail -->
      <button type="button"
              data-action="click->lesson-sidebar#toggle"
              class="absolute -left-3 top-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-white border border-stone-300 shadow-xs flex items-center justify-center text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition cursor-pointer"
              title="Expand tools sidebar"
              aria-label="Expand tools sidebar">
        <svg style="width: 10px; height: 10px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
    </div>

    <!-- The 3 Option Icons -->
    <div class="flex flex-col items-center gap-2 w-full">
      <!-- 1. AI Tutor Icon -->
      <button type="button"
              data-action="click->lesson-sidebar#openTab"
              data-tab="ai_tutor"
              data-lesson-sidebar-target="railButton"
              class="relative w-10 h-10 rounded-xl text-stone-600 hover:bg-stone-100 hover:text-emerald-700 transition flex items-center justify-center cursor-pointer group"
              title="AI Tutor (Ask doubts in Hinglish)"
              aria-label="AI Tutor">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/>
        </svg>
      </button>

      <!-- 2. Chatroom Icon -->
      <button type="button"
              data-action="click->lesson-sidebar#openTab"
              data-tab="chatroom"
              data-lesson-sidebar-target="railButton"
              class="relative w-10 h-10 rounded-xl text-stone-600 hover:bg-stone-100 hover:text-blue-700 transition flex items-center justify-center cursor-pointer group"
              title="Classroom Chatroom"
              aria-label="Classroom Chatroom">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <% if comments_count > 0 %>
          <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-blue-600 ring-2 ring-white"></span>
        <% end %>
      </button>

      <!-- 3. Notes Icon -->
      <button type="button"
              data-action="click->lesson-sidebar#openTab"
              data-tab="notes"
              data-lesson-sidebar-target="railButton"
              class="relative w-10 h-10 rounded-xl text-stone-600 hover:bg-stone-100 hover:text-amber-700 transition flex items-center justify-center cursor-pointer group"
              title="Class & Topic Notes"
              aria-label="Class & Topic Notes">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <% if notes_count > 0 %>
          <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-amber-600 ring-2 ring-white"></span>
        <% end %>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div data-lesson-sidebar-target="backdrop"
       data-action="click->lesson-sidebar#close"
       class="hidden fixed inset-0 bg-stone-900/40 backdrop-blur-xs z-45 md:hidden transition-opacity"></div>

  <!-- ======================================================== -->
  <!-- 2. EXPANDED SIDEBAR DRAWER (Full interactive tools panel) -->
  <!-- ======================================================== -->
  <div data-lesson-sidebar-target="drawer"
       style="transform: translateX(100%); pointer-events: none;"
       class="fixed right-0 top-16 bottom-0 z-50 w-full sm:max-w-[460px] bg-white border-l border-stone-200 shadow-2xl flex flex-col transition-transform duration-300 ease-out translate-x-full pointer-events-none">

    <!-- Top Drawer Navigation: 3 Option Tabs & Collapse Button -->
    <div class="px-3.5 py-2.5 border-b border-stone-200 bg-stone-50/90 flex items-center justify-between gap-2 shrink-0">
      <div class="flex items-center gap-1 overflow-x-auto scrollbar-none py-0.5">
        <!-- Tab 1: AI Tutor -->
        <button type="button"
                data-action="click->lesson-sidebar#switchTab"
                data-tab="ai_tutor"
                data-lesson-sidebar-target="tabButton"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer shrink-0">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
          </svg>
          <span>AI Tutor</span>
        </button>

        <!-- Tab 2: Chatroom -->
        <button type="button"
                data-action="click->lesson-sidebar#switchTab"
                data-tab="chatroom"
                data-lesson-sidebar-target="tabButton"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer shrink-0">
          <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <span>Chatroom</span>
          <% if comments_count > 0 %>
            <span class="text-[10px] font-mono font-bold bg-stone-200 text-stone-800 px-1.5 py-0.2 rounded-full">
              <%= comments_count %>
            </span>
          <% end %>
        </button>

        <!-- Tab 3: Notes -->
        <button type="button"
                data-action="click->lesson-sidebar#switchTab"
                data-tab="notes"
                data-lesson-sidebar-target="tabButton"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer shrink-0">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span>Notes</span>
          <% if notes_count > 0 %>
            <span class="text-[10px] font-mono font-bold bg-stone-200 text-stone-800 px-1.5 py-0.2 rounded-full">
              <%= notes_count %>
            </span>
          <% end %>
        </button>
      </div>

      <!-- Collapse button: shows '✕' on mobile and '>' on desktop -->
      <button type="button"
              data-action="click->lesson-sidebar#close"
              class="w-8 h-8 rounded-lg text-stone-400 hover:text-stone-900 hover:bg-stone-200/60 transition flex items-center justify-center cursor-pointer shrink-0"
              title="Close sidebar"
              aria-label="Close sidebar">
        <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" class="md:hidden" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" class="hidden md:block" />
        </svg>
      </button>
    </div>

    <!-- Drawer Content Area -->
    <div class="flex-1 overflow-y-auto p-4 space-y-4 scrollbar-thin">
      <!-- Panel 1: AI Tutor -->
      <div data-lesson-sidebar-target="tabContent" data-tab-name="ai_tutor">
        <%= render partial: "lessons/ai_tutor" %>
      </div>

      <!-- Panel 2: Chatroom -->
      <div data-lesson-sidebar-target="tabContent" data-tab-name="chatroom" class="hidden">
        <%= render partial: "lesson_comments/section" %>
      </div>

      <!-- Panel 3: Notes -->
      <div data-lesson-sidebar-target="tabContent" data-tab-name="notes" class="hidden">
        <%= render partial: "lessons/notes_section" %>
      </div>
    </div>
  </div>
</aside>
