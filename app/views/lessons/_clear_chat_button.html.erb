<div id="clear_chat_container">
  <% if authenticated? && local_assigns[:has_messages] %>
    <%= button_to clear_chat_lesson_path(lesson), method: :delete, data: { turbo_confirm: "Clear chat history for this lesson?" }, class: "text-[11px] font-medium text-stone-400 hover:text-red-600 transition flex items-center gap-1 cursor-pointer" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
      <span>Clear Chat</span>
    <% end %>
  <% end %>
</div>

