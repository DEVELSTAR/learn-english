<div id="chat_input_container" data-controller="chat-tutor">
  <!-- Quick prompt chips -->
  <div class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-none text-[11px]">
    <span class="text-stone-400 font-medium whitespace-nowrap text-[10px] uppercase tracking-wider">Quick Prompts:</span>
    <button type="button" 
            data-action="click->chat-tutor#fillPrompt" 
            data-prompt="Check my sentence: " 
            class="px-2.5 py-1 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-full font-medium whitespace-nowrap transition cursor-pointer border border-stone-200">
      ✍️ Correct my sentence
    </button>
    <button type="button" 
            data-action="click->chat-tutor#fillPrompt" 
            data-prompt="Can you explain this lesson in simpler Hinglish with a fresh analogy?" 
            class="px-2.5 py-1 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-full font-medium whitespace-nowrap transition cursor-pointer border border-stone-200">
      💡 Simpler Hinglish
    </button>
    <button type="button" 
            data-action="click->chat-tutor#fillPrompt" 
            data-prompt="Give me 2 natural everyday sentences using these words in Indian workplace or daily life." 
            class="px-2.5 py-1 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-full font-medium whitespace-nowrap transition cursor-pointer border border-stone-200">
      🗣️ Real-life examples
    </button>
    <button type="button" 
            data-action="click->chat-tutor#fillPrompt" 
            data-prompt="Ask me 1 quick fill-in-the-blank question to test my understanding of this lesson." 
            class="px-2.5 py-1 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-full font-medium whitespace-nowrap transition cursor-pointer border border-stone-200">
      🎯 Quiz me
    </button>
  </div>

  <!-- Chat form -->
  <%= form_with url: lesson_chat_messages_path(lesson), method: :post, id: "chat_message_form", data: { action: "turbo:submit-start->chat-tutor#submitting turbo:submit-end->chat-tutor#submitted" }, class: "relative mt-1" do |f| %>
    <div class="flex items-center gap-2 bg-white rounded-xl border border-stone-300 focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-100 transition p-1.5 shadow-2xs">
      <input type="text" 
             name="content" 
             id="chat_form_input"
             data-chat-tutor-target="input"
             autocomplete="off" 
             required 
             placeholder="Ask a question or type a sentence for correction..." 
             class="w-full bg-transparent px-3 py-1.5 text-xs sm:text-sm text-stone-900 focus:outline-none placeholder:text-stone-400">
      
      <button type="submit" 
              data-chat-tutor-target="submitButton"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-semibold transition cursor-pointer shrink-0 shadow-2xs">
        <span data-chat-tutor-target="buttonText">Send</span>
        <svg class="w-3.5 h-3.5 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m-7 7l7-7 7 7"/>
        </svg>
      </button>
    </div>

    <div data-chat-tutor-target="indicator" class="hidden text-[11px] text-emerald-700 font-medium pt-1.5 flex items-center gap-1.5 animate-pulse" style="display: none;">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-600"></span>
      <span>Akib Sir is thinking and writing your feedback...</span>
    </div>
  <% end %>
</div>

