<% content_for :title, "Daily Classes" %>

<div class="space-y-6">
  <!-- Header & Search -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-stone-200 pb-5">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-stone-900">Daily Classes</h1>
      <p class="text-sm text-stone-500 mt-1">Browse all daily Hinglish vocabulary, expressions, and grammar lessons.</p>
    </div>

    <!-- Search bar -->
    <%= form_with url: lessons_path, method: :get, class: "flex items-center gap-2 w-full md:w-80" do %>
      <%= text_field_tag :query, params[:query], placeholder: "Search lessons...", class: "w-full rounded-lg border border-stone-300 px-3 py-1.5 text-xs text-stone-900 focus:border-stone-900 focus:outline-none" %>
      <%= submit_tag "Search", class: "px-3 py-1.5 bg-stone-900 text-white rounded-lg text-xs font-medium hover:bg-stone-800 cursor-pointer" %>
    <% end %>
  </div>

  <!-- Lessons List -->
  <% if @lessons.any? %>
    <div class="space-y-4">
      <% @lessons.each do |lesson| %>
        <article class="p-6 rounded-xl border border-stone-200 bg-white hover:border-stone-300 transition shadow-xs">
          <div class="flex items-center justify-between gap-4 mb-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-medium text-stone-500"><%= lesson.lesson_date.strftime("%B %d, %Y") %></span>
              <% if authenticated? && lesson.completed_by?(current_user) %>
                <span class="text-[11px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-medium">✓ Completed</span>
              <% end %>
            </div>
          </div>

          <h2 class="text-xl font-bold text-stone-900 mb-2">
            <%= link_to lesson.title, lesson_path(lesson), class: "hover:underline" %>
          </h2>

          <% snippet = lesson.content.to_plain_text.strip.truncate(180) if lesson.content.present? %>
          <% if snippet.present? %>
            <p class="text-sm text-stone-600 line-clamp-2 mb-4 leading-relaxed">
              <%= snippet %>
            </p>
          <% end %>

          <div class="flex items-center justify-end pt-2 border-t border-stone-100 text-xs">
            <%= link_to "Read Class →", lesson_path(lesson), class: "font-semibold text-stone-900 hover:underline" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-xl border border-stone-200 p-8">
      <p class="text-stone-600 text-sm">No classes found matching your search.</p>
      <% if params[:query].present? %>
        <%= link_to "Clear search", lessons_path, class: "inline-block mt-3 text-xs font-medium text-stone-900 underline" %>
      <% end %>
    </div>
  <% end %>
</div>
