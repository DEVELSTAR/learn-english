<% if notice = flash[:notice] %>
  <div data-controller="notification" class="mb-4 flex items-center justify-between p-3.5 rounded-lg bg-emerald-50/90 border border-emerald-200 text-sm text-emerald-900 shadow-xs transition-all duration-300" role="alert">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <span><%= notice %></span>
    </div>
    <button type="button" data-action="click->notification#dismiss" class="text-emerald-700 hover:text-emerald-900 p-1 text-xs cursor-pointer">✕</button>
  </div>
<% end %>

<% if alert = flash[:alert] %>
