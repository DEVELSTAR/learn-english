    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      <span><%= alert %></span>
    </div>
    <button type="button" data-action="click->notification#dismiss" class="text-red-700 hover:text-red-900 p-1 text-xs cursor-pointer">✕</button>
