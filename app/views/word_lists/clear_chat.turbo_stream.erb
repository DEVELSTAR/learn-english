<%= turbo_stream.update "word_list_chat_messages_list" do %>
  <%= render partial: "word_lists/chat_empty_state", locals: { word_list: @word_list } %>
<% end %>

<%= turbo_stream.replace "word_list_chat_input_container" do %>
  <%= render partial: "word_lists/chat_input", locals: { word_list: @word_list } %>
<% end %>

<%= turbo_stream.replace "word_list_clear_chat_container" do %>
  <%= render partial: "word_lists/clear_chat_button", locals: { word_list: @word_list, has_messages: false } %>
<% end %>

<%= turbo_stream.update "flash_messages" do %>
  <%= render partial: "shared/flash" %>
<% end %>

