<!DOCTYPE html>
<html lang="en" class="h-full bg-stone-50 text-stone-900 antialiased">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} — Learn English" : "Learn English — Daily Hinglish Vocabulary & Concepts" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Learn English">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full flex flex-col font-sans selection:bg-stone-200">
    <!-- Main Top Navigation -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-stone-200" data-controller="toggle">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-16">
          <!-- Logo & Brand -->
          <div class="flex items-center gap-6">
            <%= link_to root_path, class: "flex items-center gap-2.5 text-stone-900 group" do %>
              <div class="w-8 h-8 rounded-lg bg-stone-900 flex items-center justify-center text-white font-semibold text-sm shadow-xs group-hover:bg-stone-800 transition">
                LE
              </div>
              <div>
                <span class="font-bold text-base tracking-tight block leading-tight">Learn English</span>
                <span class="text-[10px] text-stone-500 font-medium tracking-wide uppercase block -mt-0.5">Daily Hinglish</span>
              </div>
            <% end %>

            <!-- Desktop Nav Links -->
            <% if authenticated? %>
              <nav class="hidden md:flex items-center gap-1 pl-4 border-l border-stone-200">
                <% if admin? %>
                  <%= link_to "Admin Panel", admin_root_path, class: "px-3 py-1.5 rounded-md text-xs font-bold bg-[#2c3e50] text-white hover:bg-[#1a252f] transition flex items-center gap-1.5 shadow-2xs mr-2" %>
                  <%= link_to "Topics", topics_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{controller_name == 'topics' ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
                  <%= link_to "Daily Classes", lessons_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{controller_name == 'lessons' ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
                <% else %>
                  <%= link_to "Home", root_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{current_page?(root_path) ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
                  <%= link_to "Topics", topics_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{controller_name == 'topics' ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
                  <%= link_to "Daily Classes", lessons_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{controller_name == 'lessons' ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
                  <%= link_to "My Words", word_lists_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{controller_name == 'word_lists' ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
                  <%= link_to "Revision", revision_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{controller_name == 'revisions' ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
                <% end %>
              </nav>
            <% else %>
              <nav class="hidden md:flex items-center gap-1 pl-4 border-l border-stone-200">
                <%= link_to "Topics", topics_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{controller_name == 'topics' ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
                <%= link_to "Daily Classes", lessons_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{controller_name == 'lessons' ? 'text-stone-900 bg-stone-100 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'} transition" %>
              </nav>
            <% end %>
          </div>

          <!-- User controls & Mobile toggle -->
          <div class="flex items-center gap-3">
            <% if authenticated? %>
              <div class="hidden sm:flex items-center gap-3">
                <span class="text-xs text-stone-500 font-medium">
                  <%= current_user.name %>
                  <% if admin? %>
                    <span class="ml-1 text-[10px] bg-stone-100 text-stone-700 px-1.5 py-0.5 rounded font-mono font-bold"><%= super_admin? ? "Super Admin" : "Admin" %></span>
                  <% end %>
                </span>
                <%= button_to "Sign out", session_path, method: :delete, class: "text-xs font-medium text-stone-500 hover:text-stone-900 py-1.5 px-2.5 rounded border border-stone-200 hover:border-stone-300 transition cursor-pointer" %>
              </div>
            <% else %>
              <div class="flex items-center gap-2">
                <%= link_to "Sign in", new_session_path, class: "text-sm font-medium text-stone-700 hover:text-stone-900 px-3 py-1.5" %>
                <%= link_to "Get Started", new_registration_path, class: "text-sm font-medium bg-stone-900 text-white px-3.5 py-1.5 rounded-md hover:bg-stone-800 transition" %>
              </div>
            <% end %>

            <!-- Mobile menu button -->
            <button type="button" data-action="click->toggle#toggle" class="md:hidden p-2 text-stone-500 hover:text-stone-900 hover:bg-stone-100 rounded-md focus:outline-none" aria-label="Toggle Navigation">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile dropdown menu -->
        <div data-toggle-target="content" class="hidden md:hidden py-3 border-t border-stone-100 space-y-1">
          <% if authenticated? %>
            <div class="px-3 py-1 text-xs font-semibold text-stone-500 uppercase tracking-wider">
              Signed in as <%= current_user.name %>
            </div>
            <% if admin? %>
              <%= link_to "Admin Panel", admin_root_path, class: "block px-3 py-2 rounded-md text-sm font-bold text-white bg-[#2c3e50] hover:bg-[#1a252f]" %>
              <%= link_to "Topics", topics_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
              <%= link_to "Daily Classes", lessons_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
            <% else %>
              <%= link_to "Home", root_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
              <%= link_to "Topics", topics_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
              <%= link_to "Daily Classes", lessons_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
              <%= link_to "My Words", word_lists_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
              <%= link_to "Revision", revision_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
            <% end %>
            <div class="pt-2 border-t border-stone-100">
              <%= button_to "Sign out", session_path, method: :delete, class: "w-full text-left px-3 py-2 text-sm text-stone-600 hover:bg-stone-100 rounded-md font-medium" %>
            </div>
          <% else %>
            <%= link_to "Topics", topics_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
            <%= link_to "Daily Classes", lessons_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
            <%= link_to "Sign in", new_session_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100" %>
            <%= link_to "Create an account", new_registration_path, class: "block px-3 py-2 rounded-md text-sm font-medium text-emerald-800 font-semibold" %>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Global Notice & Alert Banners -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 w-full mt-4">
      <div id="flash_messages">
        <%= render partial: "shared/flash" %>
      </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 w-full py-6">
      <%= yield %>
    </main>

    <!-- Minimalist Footer -->
    <footer class="border-t border-stone-200 bg-white/50 py-6 mt-16 text-center text-xs text-stone-500">
      <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>Learn English — Concept-first Hinglish vocabulary learning.</p>
        <p class="text-stone-400">Calm, distraction-free education.</p>
      </div>
    </footer>
  </body>
</html>
